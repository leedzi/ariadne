@echo off
REM ========== API配置 ==========
set OPENAI_API_KEY=your-api-key-here
set OPENAI_BASE_URL=https://api.openai.com/v1
set OPENAI_MODEL=gpt-4-vision-preview

REM ========== 表情包目录 ==========
set EMOJI_DIR=data/avatars/ATRI/emoji

